# Firebase web app (public configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional server-only account for payment settlement/newsletter/admin bootstrap.
# Never use a NEXT_PUBLIC_ prefix for this value. Keep it in protected local/Vercel secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Existing Toss integration; configure real credentials before enabling checkout.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
