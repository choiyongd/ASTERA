# ==========================================================
# Supabase (프로젝트 설정 > API 에서 확인)
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# service_role 키는 절대 브라우저에 노출되면 안 됩니다. 서버(API 라우트)에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY

# ==========================================================
# 토스페이먼츠 (developers.tosspayments.com 에서 발급)
# 아래 클라이언트 키는 토스페이먼츠가 문서/튜토리얼용으로 공개한
# "테스트 전용" 값으로, 회원가입 없이 결제위젯 화면 테스트가 가능합니다.
# 실제 결제 승인(서버)에는 본인 계정의 테스트 시크릿 키가 필요합니다.
# 발급 방법은 SETUP_GUIDE.md 를 참고하세요.
# ==========================================================
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=YOUR_TOSS_TEST_SECRET_KEY

# 사이트 기본 URL (결제 성공/실패 리다이렉트에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
