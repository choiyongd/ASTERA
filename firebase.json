    "authorizedDomains": [
      "localhost",
      "astera-mu.vercel.app",
      "astera-learning-choiyongd.firebaseapp.com",
      "astera-learning-choiyongd.web.app",
      "astera-git-codex-firebase-learn-d87fc7-choiyongd-3326s-projects.vercel.app"
